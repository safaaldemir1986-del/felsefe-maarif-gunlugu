{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Felsefe Maarif Günlüğü",
  "version": "0.1.0",
  "identifier": "tr.felsefemaarif.gunluk",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Felsefe Maarif Günlüğü",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "maximized": true,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Felsefe Maarif Günlüğü",
    "category": "Education",
    "shortDescription": "Felsefe öğretmenleri için kişisel masaüstü günlüğü.",
    "longDescription": "Yıllık plan, günlük plan, performans ödevleri, etkinlik fikirleri, önemli gün ve haftalar ile kişisel ajandayı tek masaüstünde birleştirir.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
